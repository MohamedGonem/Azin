importc "stdio.h"


enum Types is
    Teacher
    Doctor
    None
end

struct Human is
    mut age: int
    mut name: string
    mut type: Types
end

fn verify(person: Human): bool do
    if person.age >= 17 then
        return true
    else
        return false
    end
end

fn cureme(person: Human) do
    if person.type == Types.Doctor then
        printf("\n\nIf you are really a doctor, cure me, I have...\n*Doctor ignores*")
    end
end

fn main: int do

    /*
        Ignores comments? 
    */
    
    // Yes it does

    var mut person1: Human
    person1.age = 18
    person1.name = "Joseph"
    person1.type = Types.Doctor

    if verify(person1) then
        printf("You may enter")
        cureme(person1)
    else
        printf("You may not enter")
    end

    return 0

end
